# Renommer et adapter. Exemple d’organisation, pas une configuration finale testée.
# Le lanceur active le profil llm seulement en mode réel.
services:
  app:
    image: ${APP_IMAGE:-assurance-local:dev}
    build: .
    environment:
      MODEL_MODE: ${MODEL_MODE:-reel}
      LLM_BASE_URL: http://llm:8080/v1
      LLM_MODEL: local-model
    ports:
      - "127.0.0.1:8000:8000"
    # TODO : attente/disponibilité, arrêt, configuration versionnée adaptée.
  llm:
    profiles: [llm]
    # TODO : fixer une version/digest CPU validé avant remise.
    image: ${LLM_IMAGE:-ghcr.io/ggml-org/llama.cpp:server}
    volumes:
      - ${MODEL_DIR:-./models}:/models:ro
    command: ["-m", "/models/model.gguf", "--host", "0.0.0.0", "--port", "8080", "--alias", "local-model"]
    # TODO : modèle acquis automatiquement par le lanceur, disponibilité vérifiée.
